{
  "name": "rush-royale-server",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "prisma db push --skip-generate && node dist/main.js",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:reset": "prisma db push --force-reset",
    "test": "jest",
    "test:engine": "jest --testPathPatterns=engine-v2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Rush Royale game server",
  "dependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.12",
    "@prisma/client": "^6.19.2",
    "@x402/core": "^2.3.1",
    "@x402/evm": "^2.3.1",
    "@x402/express": "^2.3.0",
    "ioredis": "^5.9.2",
    "prisma": "^6.19.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
